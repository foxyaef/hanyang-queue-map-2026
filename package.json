{
  "name": "hanyang-queue-map-2026",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "backend:dev": "wrangler dev --config backend/wrangler.jsonc",
    "backend:typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "backend:check": "wrangler deploy --dry-run --config backend/wrangler.jsonc --outdir dist",
    "backend:db:local": "wrangler d1 migrations apply hanyang-queue-db --local --config backend/wrangler.jsonc",
    "backend:db:remote": "wrangler d1 migrations apply hanyang-queue-db --remote --config backend/wrangler.jsonc",
    "backend:deploy": "wrangler deploy --config backend/wrangler.jsonc"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
